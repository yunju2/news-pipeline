#default dev
app_env=dev 
# Groq API Key
# 발급: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# OpenAI API Key
# 발급: https://platform.openai.com
OPENAI_API_KEY=your_openAI_api_key_here
# Google API Key
# 발급: https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here
OPENROUTER_API_KEY=your_openRouter_api_key_here
# AWS 
AWS_S3_BUCKET=s3_bucket_name

# Email delivery (Amazon SES)
NEWS_PIPELINE_EMAIL_ENABLED=false
NEWS_PIPELINE_EMAIL_FROM=verified-sender@example.com
NEWS_PIPELINE_EMAIL_TO=recipient1@example.com,recipient2@example.com
NEWS_PIPELINE_EMAIL_SUBJECT_PREFIX=[News Pipeline]
